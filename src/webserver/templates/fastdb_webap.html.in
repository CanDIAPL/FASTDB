{% extends 'base.html' %}

{% block head %}
<meta name="fastdb-base-path" content="{{ request.script_root }}/">
<link rel="stylesheet" href="{{ url_for('static', filename='fastdb.css') }}">
<script src="{{ url_for('static', filename='fastdb.js') }}" type="module"></script>
<script src="{{ url_for('static', filename='fastdb_start.js') }}" type="module"></script>
{% endblock %}

{% block title %}FASTDB Web UI{% endblock %}

{% block content %}
  <div name="bodydiv" id="bodydiv" class="bodydiv">
    <div name="authdiv" id="authdiv" class="authdiv"></div>
    <div name="pagebody" id="pagebody" class="pagebody"></div>
  </div>
{% endblock %}
